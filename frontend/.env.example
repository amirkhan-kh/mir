# Docker / local dev only: API origin for rewrites and server fetches (no trailing slash).
# On Vercel leave unset — the root vercel.json routes /api and /uploads, and the BACKEND_URL binding is injected.
API_INTERNAL_URL=http://localhost:4010
# Public origin of the storefront (metadata, sitemap, robots). Optional on Vercel.
SITE_URL=https://mir.example.uz
